<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>

        <!-- Fires the notification when a reminder is due. -->
        <receiver
            android:name=".ReminderReceiver"
            android:exported="false" />

        <!-- Re-arms reminders that are still in the future after a restart. -->
        <receiver
            android:name=".BootReceiver"
            android:exported="true"
            android:directBootAware="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
        <!--
          The accessibility service behind the volume-key trigger and the floating
          microphone. It has to be an accessibility service because Android hands the
          volume keys to those and to nothing else. It must be exported, because the
          system binds it from outside the app; it stays inert until the user turns it on
          in Settings > Accessibility.
        -->
        <service
            android:name=".VoiceAccessService"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/voice_access_service" />
        </service>

        <!--
          Always-on listening for "Hey VCC". Not exported and not sticky: it starts only
          when the user asks for it and stays off after a restart. A microphone that
          re-arms itself would be the wrong default for anyone.
        -->
        <service
            android:name=".WakeWordService"
            android:exported="false"
            android:foregroundServiceType="microphone" />
    </application>

    <!--
      Package visibility. Without these, SpeechRecognizer cannot see the on-device
      recognition service and ACTION_SENDTO cannot be resolved on API 30+.
    -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SENDTO" />
            <data android:scheme="smsto" />
        </intent>
        <intent>
            <action android:name="android.intent.action.DIAL" />
            <data android:scheme="tel" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SET_ALARM" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SET_TIMER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.WEB_SEARCH" />
        </intent>
        <!-- navigate_to asks the package manager whether a turn-by-turn app exists
             before choosing between google.navigation: and a plain geo: pin. -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="geo" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="google.navigation" />
        </intent>
    </queries>

    <!-- Permissions -->

    <!-- Loopback access to the local Needle engine process. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Speech input. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Turning a spoken contact name into a phone number for send_sms and dial_contact,
         and turning a number back into a name when reading messages out. -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <!-- read_messages reads the inbox aloud. On a sideloaded build this is grantable;
         it is a restricted permission only for Play Store distribution. -->
    <uses-permission android:name="android.permission.READ_SMS" />
    <!-- answer_call needs both: one to pick the call up, one to see that it is ringing. -->
    <uses-permission android:name="android.permission.ANSWER_PHONE_CALLS" />
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <!-- open_app looks an app up by the name the user said. Android 11+ hides the app
         list without this, so "open WhatsApp" would find nothing. -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />
    <!-- Android 13+ runtime permission for the reminder notification. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- The floating microphone. Granted from Settings > Apps > Special access, not by a
         runtime prompt, so the app has to send the user there. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- Always-on wake-word listening. Android 14+ requires the typed permission to match
         the service's declared foregroundServiceType, or the service cannot start at all. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <!-- Exact reminders on Android 12+. Checked at runtime with
         AlarmManager.canScheduleExactAlarms(); the app falls back when it is denied. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <!-- Re-schedule reminders after the device restarts. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Reading the current Wi-Fi state for spoken feedback, and the legacy silent
         toggle on API < 29 only. -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <!-- The `network:` session fact handed to the model. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- The torch is a nice-to-have: do not hide the app from devices without a flash. -->
    <uses-feature
        android:name="android.hardware.camera.flash"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.microphone"
        android:required="false" />
</manifest>
