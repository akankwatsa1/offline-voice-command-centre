# Dependencies
node_modules/

# npm's default cache lives outside this folder, which some sandboxes block, so the
# project points npm at its own cache directory instead. Never commit it.
.npm-cache/

# Needle 3 engine + weights: fetched, never committed (33.7 MB of weights).
models/

# Staged into the Android project at build time, not sources.
android/app/src/main/assets/needle3.cact
android/app/src/main/assets/tools.json
android/app/src/main/jniLibs/

# Android build output
android/build/
android/app/build/
android/.gradle/
android/local.properties
android/capacitor-cordova-android-plugins/build/
*.apk
*.aab

# Downloaded build artifacts land here. A 38 MB APK was accidentally committed once; it
# does not belong in the history of a source repository.
dist/
